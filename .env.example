# ---- network ----
# Port on the host (docker compose maps it to the container's 8080). Plain HTTP for now.
API_PORT=443
# API worker processes (each can run searches in parallel)
WORKERS=2

# ---- where the logs are (read-only) ----
# Vector writes s3://<LOGS_BUCKET>/<LOGS_PREFIX><cluster>/dt=YYYY-MM-DD/hour=HH/*.parquet
LOGS_BACKEND=s3
LOGS_BUCKET=fenix-ecr-logs
LOGS_PREFIX=vector/
LOGS_REGION=us-west-2

# ---- search limits ----
# One search may cover at most this many hours (it can start anywhere in the 30 days S3 keeps)
MAX_SEARCH_HOURS=168
MAX_FILES_PER_SEARCH=30000
MAX_EXPORT_ROWS=10000
# Downloaded Parquet files are kept here (Docker volume); oldest are removed above this size
CACHE_DIR=/app/cache
CACHE_MAX_MB=8192
# DuckDB per search: CPU threads and memory cap (keep WORKERS x DUCKDB_MEMORY_MB well under the
# instance's free RAM; ES-API runs on the same host)
DUCKDB_THREADS=2
DUCKDB_MEMORY_MB=768
DOWNLOAD_THREADS=32

# ---- ECS health page (read-only: ECS, load balancers, EC2) ----
HEALTH_ENABLED=true
ECS_REGION=us-west-2
# AWS is read at most this often (seconds); the page refreshes every minute
HEALTH_CACHE_SECONDS=60

# ---- load balancer access logs (read-only) ----
# ALBs write gzip logs to s3://<LB_LOGS_BUCKET>/<LB_LOGS_PREFIX>AWSLogs/<account>/elasticloadbalancing/...
# A background job converts them to Parquet under CACHE_DIR/lb (about 400 MB a day for two ALBs).
LB_ENABLED=true
LB_LOGS_BUCKET=fenix-vector-ecs-logs
LB_LOGS_PREFIX=loadbalancer-logs/
LB_LOGS_REGION=us-west-2
# Days kept converted all the time; older ranges (up to LB_RETENTION_DAYS) are converted when someone views them
LB_WARM_DAYS=7
LB_RETENTION_DAYS=30
# How often the converter looks for new files (seconds), and its DuckDB memory
LB_POLL_SECONDS=300
LB_CONVERTER_MEMORY_MB=256

# ---- app state: users and saved searches (S3) ----
STORAGE_BACKEND=s3
S3_BUCKET=fenix-es-config-api
S3_PREFIX=vector-logs/
AWS_REGION=us-east-1

# ---- secrets: AWS Secrets Manager ----
# The app creates and updates these itself (EC2 role needs docs/iam-policy.json):
#   vector-logs/app            session signing key + first-admin password
#   vector-logs/users/<email>  password hashes
SECRETS_BACKEND=aws
SECRETS_PREFIX=vector-logs/

# ---- sign-in ----
AUTH_MODE=password
SESSION_HOURS=12
# Set to true once the app is served over HTTPS
COOKIE_SECURE=false
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Admin emails (comma-separated); always admins and cannot be deleted in the console
BOOTSTRAP_ADMINS=latish.madapada@fenixcommerce.com
# The first password for the bootstrap admin is generated into vector-logs/app (field
# bootstrapAdminPassword) on first start; read it in the AWS console, sign in, change it.
